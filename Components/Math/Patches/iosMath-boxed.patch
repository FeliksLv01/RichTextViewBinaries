+
+- (void)setFramePadding:(CGFloat)padding
+{
+    CGFloat delta = padding - _framePadding;
+    _framePadding = padding;
+    self.width += 2 * delta;
+    self.ascent += delta;
+    self.descent += delta;
+    [self updateChildPosition];
 }
 
